        private (double[], double[]) GetHourlyData(List<FileTransaction> transactions)
        {
            var hourly = transactions
                         .GroupBy(t => t.Time.Hour)
                         .Select(g => new
                         {
                             Hour = g.Key,
                             Amount = g.Sum(t => t.Amount)
                         })
                         .OrderBy(x => x.Hour)
                         .ToList();

            double[] hx = hourly.Select(x => (double)x.Hour).ToArray();
            double[] hy = hourly.Select(x => (double)x.Amount).ToArray();
            return (hx, hy);
        }
        private (double[], double[]) GetDailyData(List<FileTransaction> transactions)
        {
            var daily = transactions
                        .GroupBy(t => t.Time.Date)
                        .Select(g => new
                        {
                            Day = g.Key,
                            Amount = g.Sum(t => t.Amount)
                        })
                        .OrderBy(x => x.Day)
                        .ToList();

            double[] dx = daily.Select(x => x.Day.ToOADate()).ToArray();
            double[] dy = daily.Select(x => (double)x.Amount).ToArray();
            return (dx, dy);
        }
        private (double[], double[]) GetMonthlyData(List<FileTransaction> transactions)
        {
            var monthly = transactions
                         .GroupBy(t => new { t.Time.Year, t.Time.Month })
                         .Select(g => new
                         {
                             Month = new DateTime(g.Key.Year, g.Key.Month, 1),
                             Amount = g.Sum(t => t.Amount)
                         })
                         .OrderBy(x => x.Month)
                         .ToList();

            double[] mx = monthly.Select(x => x.Month.ToOADate()).ToArray();
            double[] my = monthly.Select(x => (double)x.Amount).ToArray();
            return (mx, my);
        }

        public void UpdateView(ViewMode mode)
        {
            double[] xs, ys;

            if (mode == ViewMode.Hourly)
            {
                (xs, ys) = GetHourlyData(transaction);
                frpDaily.Plot.Clear();
                frpDaily.Plot.Add.Scatter(xs, ys);
                frpDaily.Refresh();
            }
                
            else if (mode == ViewMode.Daily)
            {
                (xs, ys) = GetDailyData(transaction);
                frpWeekly.Plot.Clear();
                frpWeekly.Plot.Add.Scatter(xs, ys);
                frpWeekly.Refresh();
            }
                
            else
            {
                (xs, ys) = GetMonthlyData(transaction);
                frpMonthly.Plot.Clear();
                frpMonthly.Plot.Add.Scatter(xs, ys);
                frpMonthly.Refresh();
            }
                
        }
        private void LoadTransactionsFromFile()
        {
            var path = GetRecentTransactionsFilePath();

            if (!File.Exists(path))
                return;

            var lines = File.ReadAllLines(path);

            transaction = lines
                .Select()
                .Where(t => t != null)
                .ToList();
        }
        

