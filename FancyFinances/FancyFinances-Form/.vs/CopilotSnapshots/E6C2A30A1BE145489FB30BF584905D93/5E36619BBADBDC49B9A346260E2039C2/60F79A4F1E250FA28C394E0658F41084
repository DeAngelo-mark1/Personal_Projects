        private void PlotDailyWindow()
        {
            var start = dailyWindowStart.Date;
            var end = start.AddDays(1);
            var txns = _helper.ReadFileTransactions(start, end);

            // group by hour
            var grouped = txns.GroupBy(t => t.Time.Hour)
                .ToDictionary(g => g.Key, g => g.Sum(x => (double)x.Amount));

            var xs = new List<double>();
            var ys = new List<double>();
            for (int h = 0; h < 24; h++)
            {
                xs.Add(h);
                ys.Add(grouped.TryGetValue(h, out var s) ? s : 0.0);
            }

            frpDaily.Plot.Clear();
            frpDaily.Plot.Add.Bar(ys.ToArray());
            frpDaily.Plot.XTicks(xs.ToArray());
            frpDaily.Plot.Title($"Daily transactions: {start:yyyy-MM-dd}");
            frpDaily.Refresh();
        }

        private void PlotWeeklyWindow()
        {
            var start = weeklyWindowStart.Date;
            var end = start.AddDays(7);
            var txns = _helper.ReadFileTransactions(start, end);

            var grouped = txns.GroupBy(t => t.Time.Date)
                .ToDictionary(g => g.Key, g => g.Sum(x => (double)x.Amount));

            var xs = new List<double>();
            var ys = new List<double>();
            for (var d = start; d < end; d = d.AddDays(1))
            {
                xs.Add(d.ToOADate());
                ys.Add(grouped.TryGetValue(d, out var s) ? s : 0.0);
            }

            frpWeekly.Plot.Clear();
            frpWeekly.Plot.Add.Scatter(xs.ToArray(), ys.ToArray(), markerSize: 6);
            frpWeekly.Plot.Axes.SetLimits(xs.First(), xs.Last(), 0, double.NaN);
            frpWeekly.Plot.XAxis.DateTimeFormat(true);
            frpWeekly.Plot.Title($"Weekly transactions: {start:yyyy-MM-dd} to {end.AddDays(-1):yyyy-MM-dd}");
            frpWeekly.Refresh();
        }

        private void PlotMonthlyWindow()
        {
            var start = monthlyWindowStart;
            var end = start.AddMonths(1);
            var txns = _helper.ReadFileTransactions(start, end);

            var grouped = txns.GroupBy(t => new DateTime(t.Time.Year, t.Time.Month, t.Time.Day))
                .ToDictionary(g => g.Key, g => g.Sum(x => (double)x.Amount));

            var days = (end - start).Days;
            var xs = new List<double>();
            var ys = new List<double>();
            for (int i = 0; i < days; i++)
            {
                var d = start.AddDays(i);
                xs.Add(d.ToOADate());
                ys.Add(grouped.TryGetValue(d, out var s) ? s : 0.0);
            }

            frpMonthly.Plot.Clear();
            frpMonthly.Plot.Add.Bar(xs.ToArray(), ys.ToArray());
            frpMonthly.Plot.Axes.SetLimits(xs.First(), xs.Last(), 0, double.NaN);
            frpMonthly.Plot.XAxis.DateTimeFormat(true);
            frpMonthly.Plot.Title($"Monthly transactions: {start:yyyy-MM}");
            frpMonthly.Refresh();
        }
