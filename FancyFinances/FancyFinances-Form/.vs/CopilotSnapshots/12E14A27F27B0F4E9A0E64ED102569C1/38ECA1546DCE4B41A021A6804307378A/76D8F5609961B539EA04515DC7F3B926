using Microsoft.EntityFrameworkCore.Internal;
using System;
using System.Collections.Generic;
using System.Text;
using Microsoft.EntityFrameworkCore;
using FancyFinances_Form.Models;
using System.Linq;
using System.Windows.Forms;

namespace FancyFinances_Form
{
    public class BudgetHelper
    {
        private readonly IDbContextFactory<AppDbContext> _contextFactory;
        private readonly Users _currentUser;

        public BudgetHelper(IDbContextFactory<AppDbContext> contextFactory, Users user)
        {
            _contextFactory = contextFactory;
            _currentUser = user;
        }

        public async void BudgetDisplay(string type)
        {
            using var ctx = _contextFactory.CreateDbContext();

            if (type == "Income")
            {
                var totalIncome = await ctx.Budgets
                .Where(b => b.BudgetID == _currentUser.UserID)
                .Select(b => b.Income ?? 0m)
                .SumAsync();

                frmFinance.btnIncome.Text = "Total Savings: R" + totalIncome.ToString("N2");
            }
            else if (type == "Expenses")
            {
                var totalExpenses = await ctx.Budgets
                .Where(b => b.BudgetID == _currentUser.UserID)
                .Select(b => b.Expenses ?? 0m)
                .SumAsync();
                btnExpenses.Text = "Total Expenses: R" + totalExpenses.ToString("N2");
            }
            else if (type == "Savings")
            {
                var totalSavings = await ctx.Budgets
                .Where(b => b.BudgetID == _currentUser.UserID)
                .Select(b => b.Savings ?? 0m)
                .SumAsync();
                btnSavings.Text = "Total Savings: R" + totalSavings.ToString("N2");
            }
            else
            {
                MessageBox.Show("Invalid type specified for BudgetDisplay.");
            }
        }
        private void UpdateBudget(string Type, int Amount)
        {
            var ctx = _contextFactory.CreateDbContext();
            ctx.Budgets.Where(b => b.BudgetID == _currentUser.UserID).ToList().ForEach(b =>
            {
                if (Type == "Expenses")
                {
                    b.Expenses = (b.Expenses ?? 0) + Amount;
                }
                else if (Type == "Income")
                {
                    b.Income = (b.Income ?? 0) + Amount;
                }
                else if (Type == "Savings")
                {
                    b.Savings = (b.Savings ?? 0) + Amount;
                }
            });

            ctx.SaveChanges();
        }
        public void AddInOrOut(string Type, int Amount, string Description)
        {
            using var ctx = _contextFactory.CreateDbContext();
            if (Type == "Expenses")
            {
                var totalExpenses = ctx.Budgets
                    .Where(b => b.BudgetID == _currentUser.UserID)
                    .Select(b => b.Expenses ?? 0m)
                    .Sum();
                totalExpenses += Amount;
                rtbRecentTransactions.AppendText($" - Expense Added: R{Amount} - {Description}, New total: R{totalExpenses:N2}\n");
                UpdateBudget("Expenses", Amount);
                BudgetDisplay("Expenses");
            }
            else if (Type == "Income")
            {
                var totalIncome = ctx.Budgets
                    .Where(b => b.BudgetID == _currentUser.UserID)
                    .Select(b => b.Income ?? 0m)
                    .Sum();
                totalIncome += Amount;
                rtbRecentTransactions.AppendText($" - Income Added: R{Amount} - {Description}, New total: R{totalIncome:N2}\n");
                UpdateBudget("Income", Amount);
                BudgetDisplay("Income");
            }
            else if (Type == "Savings")
            {
                var totalSavings = ctx.Budgets
                    .Where(b => b.BudgetID == _currentUser.UserID)
                    .Select(b => b.Savings ?? 0m)
                    .Sum();
                totalSavings += Amount;
                rtbRecentTransactions.AppendText($" - Savings Added: R{Amount} - {Description}, New total: R{totalSavings:N2}\n");
                UpdateBudget("Savings", Amount);
                BudgetDisplay("Savings");
            }
            else
            {
                MessageBox.Show("Invalid type specified for AddInOrOut.");
            }
            SaveRecentTransactions();
            ctx.SaveChanges();
        }

    }
}
